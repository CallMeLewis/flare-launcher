# Dependencies
node_modules/
.pnpm-store/

# Build output: the app, the installers and AppImages, and anything unpacked from them
dist/
src-tauri/target/
# Generated by Tauri at build time (capability schemas, mobile projects)
src-tauri/gen/
*.tsbuildinfo
**/*.rs.bk
squashfs-root/
*.AppImage
*.sig
/*.exe

# Stray files at the top of the repo: screenshots and downloads belong elsewhere
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
/*.zip

# Caches and local tool state
.vite/
.eslintcache
.wrangler/
.cache/
coverage/
test-results/
playwright-report/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Environment and secrets. The update signing key lives in ~/.dayz-server-launcher, never here.
.env
.env.*
!.env.example
*.pem
*.key
update-signing-key*

# Editors and operating systems
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
