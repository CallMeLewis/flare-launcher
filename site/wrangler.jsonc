// The download page. `pnpm site` runs it locally, `pnpm site:deploy` publishes it.
{
  "name": "flare-launcher",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/download/*", "/thanks", "/thanks/*", "/changelog", "/changelog/", "/latest.json"]
  },
  // CHANGELOG.md is bundled into the worker as text for the changelog page.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "observability": { "enabled": true }
}
