{
  "name": "flare-launcher",
  "private": true,
  "version": "1.1.6",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^24.13.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && tsc -p scripts && vite build",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build",
    "test": "vitest run",
    "i18n": "lingui extract --clean",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --check --manifest-path src-tauri/Cargo.toml",
    "changelog": "node scripts/check-changelog.ts",
    "bump": "node scripts/bump-version.ts",
    "dist": "pnpm changelog && tauri build --bundles nsis",
    "dist:cross": "pnpm changelog && tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis",
    "dist:linux": "pnpm changelog && node scripts/build-linux.ts",
    "release": "node scripts/publish-update.ts release",
    "release:feed": "node scripts/publish-update.ts feed"
  },
  "dependencies": {
    "@fontsource-variable/fira-code": "5.3.0",
    "@fontsource/fira-sans": "5.3.0",
    "@lingui/core": "6.9.0",
    "@lingui/message-utils": "6.9.0",
    "@lingui/react": "6.9.0",
    "@tanstack/react-virtual": "3.14.13",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.45.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@lingui/cli": "6.9.0",
    "@lingui/conf": "6.9.0",
    "@lingui/format-po": "6.9.0",
    "@lingui/vite-plugin": "6.9.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.86.0",
    "prettier": "3.9.6",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.146.0"
  }
}
