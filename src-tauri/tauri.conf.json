{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Flare Launcher",
  "version": "../package.json",
  "identifier": "com.callmelewis.dayzserverlauncher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Flare Launcher",
        "width": 1440,
        "height": 860,
        "minWidth": 1120,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "fullscreen": false,
        "backgroundColor": "#0B1120"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' http://127.0.0.1:5173 ws://127.0.0.1:5173; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:5173 ws://127.0.0.1:5173"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3NUI2NTJEM0RFMTY5RkEKUldUNmFlRTlMV1ZiaDlWTzlUeWZRREI2U3hKREpDZEhFTlAwQVN3YWJBNU1QRDY3V3NIUG44S0oK",
      "endpoints": ["https://updates.darkzone.dev/dayz-server-launcher/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "CallMeLewis",
    "copyright": "Copyright © 2026 CallMeLewis",
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
